// Prisma Schema for Knowledge Base Platform
// Implements hierarchical document structure with self-referencing relations
// and many-to-many related documents

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String   @db.Text
  order     Int      @default(0)
  isPublished Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-referencing hierarchical relationship
  parentDocumentId Int?
  parent           Document?  @relation("DocumentHierarchy", fields: [parentDocumentId], references: [id], onDelete: Cascade)
  children         Document[] @relation("DocumentHierarchy")

  // Many-to-many self-relation for related documents
  relatedDocuments Document[] @relation("DocumentRelations")
  isRelatedTo      Document[] @relation("DocumentRelations")

  @@index([slug])
  @@index([parentDocumentId])
  @@index([order])
  @@index([isPublished])
  @@map("documents")
}
